<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ProjectActivity" />
        <activity android:name=".ManifestActivity" />
        <activity android:name=".SmaliFilesActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".EditorActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".InjectActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".StringsActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".IdentityActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AssetsActivity" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".DexActivity" />
        <activity android:name=".BuildActivity" />

        <provider
            android:name=".ShareProvider"
            android:authorities="com.mutagen.lab.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
