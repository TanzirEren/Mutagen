<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@color/bg0</item>
        <item name="android:navigationBarColor">@color/bg0</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">#6F678F</item>
        <item name="android:colorAccent">@color/accent2</item>
        <item name="android:colorBackground">@color/bg1</item>
        <item name="android:alertDialogTheme">@style/MutDialog</item>
        <item name="android:popupMenuStyle">@style/MutPopup</item>
    </style>

    <style name="MutDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:colorAccent">@color/accent2</item>
    </style>

    <style name="MutPopup" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_card</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnGhost" parent="Btn">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="BtnDanger" parent="Btn">
        <item name="android:background">@drawable/bg_btn_danger</item>
    </style>

    <style name="Input" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">#6F678F</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">13dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
